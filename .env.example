# SearXNG instance URL (required)
# The URL of your SearXNG instance, e.g., http://localhost:8080 or http://searxng:8080 (Docker)
SEARXNG_URL=http://localhost:8080

# MCP API Key for Bearer token authentication (optional)
# If not set, authentication is disabled (dev mode)
MCP_API_KEY=

# Server port (optional, default: 3000)
PORT=3000
