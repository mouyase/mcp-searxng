{
  "name": "mcp-searxng",
  "version": "0.0.3",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap",
    "start": "bun run dist/index.js",
    "lint": "oxlint --type-aware --tsconfig=tsconfig.json src/ __test__/",
    "lint:fix": "oxlint --type-aware --tsconfig=tsconfig.json src/ __test__/ --fix",
    "fmt": "oxfmt src/ __test__/",
    "fmt:check": "oxfmt src/ __test__/ --check",
    "check": "bun run lint && bun run fmt:check",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.20.0"
  }
}
